// Simple test of public endpoints.
// Run with `cargo run --example fetch_instruments`

use derive_rust_sdk::apis::configuration::Configuration;
use derive_rust_sdk::apis::public_api::PublicApi;
use derive_rust_sdk::apis::public_api::{PublicApiClient, PublicGetAllInstrumentsPostParams};
use derive_rust_sdk::models::{
    Depth, Group, InstrumentTypeEnum, PublicGetAllInstrumentsParamsSchema,
};
use derive_rust_sdk::types::{Environment, ExternalEvent};
use derive_rust_sdk::ws_client::WsClient;
use std::sync::Arc;
use tracing::info;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    tracing_subscriber::fmt()
        .with_max_level(tracing::Level::INFO)
        .init();
    let config = Configuration {
        ..Default::default()
    };
    let config = Arc::new(config);
    let client = PublicApiClient::new(config);

    let params = PublicGetAllInstrumentsPostParams {
        public_get_all_instruments_params_schema: PublicGetAllInstrumentsParamsSchema {
            expired: false,
            instrument_type: InstrumentTypeEnum::Perp,
            ..Default::default()
        },
    };
    let response = client.public_get_all_instruments_post(params).await?;

    println!(
        "Retrieved {} instruments",
        response.result.instruments.len()
    );

    let env = Environment::Mainnet;

    let ws_client = WsClient::new_public(env).await?;

    for instrument in &response.result.instruments {
        info!("Instrument: {instrument:?}");
        ws_client
            .subscriptions()
            .market_data()
            .orderbook(
                &instrument.instrument_name,
                Depth::Variant20,
                Group::Variant1,
                move |book_update, channel| async move {
                    info!(
                        "channel: {channel}, instrument: {}, publish_id: {}, timestamp: {} bids: {:?}, asks: {:?}",
                        book_update.instrument_name, book_update.publish_id, book_update.timestamp, book_update.bids, book_update.asks
                    );
                },
            )
            .await?;
    }

    loop {
        ws_client.wait_for_connection().await;
        match ws_client.run_till_event().await {
            ExternalEvent::Connected => {
                info!("WebSocket connected");
            }
            ExternalEvent::Disconnected => {
                info!("WebSocket disconnected");
            }
            ExternalEvent::Exited => {
                info!("WebSocket exited");
                break;
            }
        }
    }
    Ok(())
}
